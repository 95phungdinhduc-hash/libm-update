<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainpane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pdm.controller.ReservationManage">
   <top>
      <AnchorPane prefHeight="0.0" prefWidth="709.0" style="-fx-background-color: #ffffff;" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="709.0" AnchorPane.bottomAnchor="7.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0">
               <children>
                  <Button fx:id="home" mnemonicParsing="false" onAction="#homeClick" styleClass="round-button" text="Home" />
                  <Pane prefHeight="46.0" prefWidth="23.0" />
                  <MenuButton mnemonicParsing="false" prefHeight="27.0" prefWidth="49.0" styleClass="round-button" text="☰" textAlignment="CENTER">
                     <items>
                        <MenuItem fx:id="book" mnemonicParsing="false" onAction="#bookClick" text="Book Catalog" />
                        <MenuItem fx:id="members" mnemonicParsing="false" onAction="#memClick" text="Members Manage" />
                        <MenuItem fx:id="loans" mnemonicParsing="false" onAction="#loanClick" text="Loans Manage" />
                        <MenuItem fx:id="reservations" mnemonicParsing="false" onAction="#reserClick" text="Reservations" />
                        <MenuItem fx:id="fines" mnemonicParsing="false" onAction="#fineClick" text="Fines" />
                        <MenuItem fx:id="report" mnemonicParsing="false" onAction="#reportClick" text="Report" />
                     </items>
                  </MenuButton>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Library Management System" textAlignment="CENTER">
                     <HBox.margin><Insets /></HBox.margin>
                  </Text>
                  <Pane prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="search_field" onAction="#doSearch" promptText="Search reservation ID, member, book title, status" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </top>
   <center>
      <StackPane prefHeight="220.0" prefWidth="1280.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="reser_table" prefHeight="220.0" prefWidth="1280.0">
               <columns>
                  <TableColumn fx:id="col_id" prefWidth="90.0" text="ID" />
                  <TableColumn fx:id="col_memid" prefWidth="100.0" text="Member ID" />
                  <TableColumn fx:id="col_memname" minWidth="0.0" prefWidth="180.0" text="Member Name" />
                  <TableColumn fx:id="col_title" prefWidth="250.0" text="Title" />
                  <TableColumn fx:id="col_date" prefWidth="130.0" text="Date" />
                  <TableColumn fx:id="col_status" prefWidth="120.0" text="Status" />
               </columns>
            </TableView>
            <Button fx:id="cancel_btn" disable="true" mnemonicParsing="false" onAction="#cancel" text="Cancel this reservation" StackPane.alignment="BOTTOM_RIGHT" />
         </children>
      </StackPane>
   </center>
   <bottom>
      <TabPane prefHeight="260.0" prefWidth="1280.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Add new reservation">
               <content>
                  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="220.0" prefWidth="1280.0">
                     <children>
                        <GridPane AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0" hgap="20.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Member ID:" />
                              <TextField fx:id="memberIdField" GridPane.columnIndex="1" promptText="e.g. M05" />
                              <Label text="Book ID or ISBN:" GridPane.columnIndex="2" />
                              <TextField fx:id="bookField" GridPane.columnIndex="3" promptText="e.g. B12 or 978-..." />
                              <Label text="Reservation Date:" GridPane.rowIndex="1" />
                              <DatePicker fx:id="reservationDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Reservation date" />
                              <Label text="" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                              <Button fx:id="add_btn" mnemonicParsing="false" onAction="#addReservation" text="Add new reservation +" GridPane.columnIndex="3" GridPane.rowIndex="2" GridPane.halignment="RIGHT" />
                           </children>
                        </GridPane>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
            <Tab text="Fulfill selected reservation">
               <content>
                  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="220.0" prefWidth="1280.0">
                     <children>
                        <GridPane AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0" hgap="20.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                              <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Select available copy:" GridPane.rowIndex="0" />
                              <ChoiceBox fx:id="copyChoice" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <Label text="Staff ID:" GridPane.rowIndex="1" />
                              <TextField fx:id="staffField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="e.g. S05" />
                              <Button fx:id="fulfillReservation_btn" disable="true" mnemonicParsing="false" onAction="#fulfillReservation" text="Fulfill " GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.halignment="RIGHT" />
                           </children>
                        </GridPane>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </bottom>
</BorderPane>
